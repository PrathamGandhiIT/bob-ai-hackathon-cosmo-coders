# IBM watsonx.ai Configuration
# If left empty, ChainGuard AI uses its built-in domain heuristic AI fallback engine.
WATSONX_APIKEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# Application Settings
APP_ENV=development
DB_PATH=app/database/supply_chain.db
PORT=8000
